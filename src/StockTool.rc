// Version resource, icon, menu and dialogs. The version numbers come from
// CMake (project(... VERSION)) via STOCKTOOL_VERSION_* so the numeric tuple
// and the strings cannot disagree.
#include <windows.h>

#include "resource.h"

// Application icon (generated by tools/make_icon.py). The first ICON
// resource is also what Explorer shows for the exe.
IDI_APPICON ICON "StockTool.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Refresh now\tF5",       IDM_REFRESH
        MENUITEM "Re&load config",         IDM_RELOAD
        MENUITEM SEPARATOR
        MENUITEM "Export &watch list (CSV)...", IDM_EXPORT_LIST
        MENUITEM "Export &chart bars (CSV)...", IDM_EXPORT_CHART
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                  IDM_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Candles",               IDM_CANDLES
        MENUITEM "Co&mpare all tickers",   IDM_COMPARE
        MENUITEM SEPARATOR
        MENUITEM "SMA &20",                IDM_SMA20
        MENUITEM "SMA &50",                IDM_SMA50
        MENUITEM "&Bollinger bands",       IDM_BOLLINGER
        MENUITEM "&RSI (14)",              IDM_RSI
        MENUITEM SEPARATOR
        MENUITEM "Trend &inset",           IDM_INSET
        MENUITEM "&News pane",             IDM_NEWS
        MENUITEM SEPARATOR
        POPUP "&Theme"
        BEGIN
            MENUITEM "Follow &system",     IDM_THEME_SYSTEM
            MENUITEM "&Light",             IDM_THEME_LIGHT
            MENUITEM "&Dark",              IDM_THEME_DARK
        END
        MENUITEM "Minimize to &tray",      IDM_MINTRAY
    END
    POPUP "&Ticker"
    BEGIN
        MENUITEM "&Add...\tCtrl+N",        IDM_ADD
        MENUITEM "&Edit...\tF2",           IDM_EDIT
        MENUITEM "&Remove",                IDM_REMOVE
        MENUITEM "Move &up\tCtrl+Up",      IDM_MOVEUP
        MENUITEM "Move &down\tCtrl+Down",  IDM_MOVEDOWN
        MENUITEM SEPARATOR
        MENUITEM "&Holding...",            IDM_HOLDING
        MENUITEM "A&lerts...",             IDM_ALERTS
    END
    POPUP "&List"
    BEGIN
        MENUITEM "&New list...",           IDM_LIST_NEW
        MENUITEM "&Rename list...",        IDM_LIST_RENAME
        MENUITEM "&Delete list",           IDM_LIST_DELETE
        MENUITEM SEPARATOR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About StockTool",       IDM_ABOUT
    END
END

// "Add ticker" dialog. Sizes are dialog units, so it scales with DPI.
IDD_ADDTICKER DIALOGEX 0, 0, 300, 196
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add tickers"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Search by company name or symbol:", -1, 7, 7, 286, 8
    EDITTEXT        IDC_QUERY, 7, 18, 236, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Search", IDC_SEARCH, 247, 17, 46, 15
    LISTBOX         IDC_RESULTS, 7, 36, 286, 62, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Symbol (Yahoo notation: TD.TO, SHOP.TO, AAPL, BRK-B):", -1, 7, 106, 200, 8
    EDITTEXT        IDC_SYMBOL, 7, 117, 200, 13, ES_AUTOHSCROLL | ES_UPPERCASE
    LTEXT           "Currency (optional):", -1, 215, 106, 78, 8
    EDITTEXT        IDC_CURRENCY, 215, 117, 78, 13, ES_AUTOHSCROLL | ES_UPPERCASE
    LTEXT           "Display name (optional):", -1, 7, 136, 286, 8
    EDITTEXT        IDC_NAME, 7, 147, 286, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_HINT, 7, 166, 286, 8
    DEFPUSHBUTTON   "Add", IDOK, 189, 177, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 243, 177, 50, 14
END

IDD_LISTNAME DIALOGEX 0, 0, 220, 78
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Watch list"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "", IDC_LTITLE, 7, 7, 206, 8
    EDITTEXT        IDC_LISTNAME, 7, 20, 206, 13, ES_AUTOHSCROLL
    LTEXT           "Letters, digits, spaces, - and _ (max 24).", IDC_LHINT, 7, 40, 206, 8
    DEFPUSHBUTTON   "OK", IDOK, 109, 59, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 59, 50, 14
END

IDD_HOLDING DIALOGEX 0, 0, 220, 96
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Holding"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "", IDC_HTITLE, 7, 7, 206, 8
    LTEXT           "Shares held:", -1, 7, 22, 80, 8
    EDITTEXT        IDC_QTY, 90, 20, 123, 13, ES_AUTOHSCROLL
    LTEXT           "Average cost per share:", -1, 7, 40, 80, 8
    EDITTEXT        IDC_COST, 90, 38, 123, 13, ES_AUTOHSCROLL
    LTEXT           "Leave both blank to clear the holding.", IDC_HHINT, 7, 58, 206, 8
    DEFPUSHBUTTON   "Save", IDOK, 109, 77, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 77, 50, 14
END

IDD_ALERTS DIALOGEX 0, 0, 220, 96
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Price alerts"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "", IDC_ATITLE, 7, 7, 206, 8
    LTEXT           "Alert when price rises to:", -1, 7, 22, 90, 8
    EDITTEXT        IDC_ABOVE, 100, 20, 113, 13, ES_AUTOHSCROLL
    LTEXT           "Alert when price falls to:", -1, 7, 40, 90, 8
    EDITTEXT        IDC_BELOW, 100, 38, 113, 13, ES_AUTOHSCROLL
    LTEXT           "Leave a field blank to disable that alert.", IDC_AHINT, 7, 58, 206, 8
    DEFPUSHBUTTON   "Save", IDOK, 109, 77, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 77, 50, 14
END

#define ST_STR_(x) #x
#define ST_STR(x)  ST_STR_(x)
#define ST_VERSION_STRING \
    ST_STR(STOCKTOOL_VERSION_MAJOR) "." ST_STR(STOCKTOOL_VERSION_MINOR) "." ST_STR(STOCKTOOL_VERSION_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    STOCKTOOL_VERSION_MAJOR,STOCKTOOL_VERSION_MINOR,STOCKTOOL_VERSION_PATCH,0
 PRODUCTVERSION STOCKTOOL_VERSION_MAJOR,STOCKTOOL_VERSION_MINOR,STOCKTOOL_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "B. Graham"
            VALUE "FileDescription",  "StockTool - stock watch list and charts"
            VALUE "FileVersion",      ST_VERSION_STRING
            VALUE "InternalName",     "StockTool"
            VALUE "OriginalFilename", "StockTool.exe"
            VALUE "ProductName",      "StockTool"
            VALUE "ProductVersion",   ST_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
